  "panels": [
    {
      "title": "ETH/USDT Spread vs 0.28% Threshold",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB_V3_ARBITRAGE}"
      },
      "gridPos": {
        "h": 9,
        "w": 18,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "spanNulls": false,
              "pointSize": 5,
              "axisPlacement": "left"
            },
            "unit": "percentunit",
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "threshold_open"
              },
              "properties": [
                {
                  "id": "custom.drawStyle",
                  "value": "line"
                },
                {
                  "id": "custom.lineStyle",
                  "value": {
                    "fill": "dash",
                    "dash": [
                      10,
                      10
                    ]
                  }
                },
                {
                  "id": "custom.lineWidth",
                  "value": 3
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB_V3_ARBITRAGE}"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(v.timeRangeStart, v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"spreads\")\n  |> filter(fn: (r) => r[\"symbol\"] == \"ETH/USDT\")\n  |> filter(fn: (r) => r[\"_field\"] == \"threshold_open\" or r[\"_field\"] == \"spread_binance_ask_bitget_bid\" or r[\"_field\"] == \"spread_bitget_ask_binance_bid\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"last\")",
          "refId": "A",
          "language": "flux"
        }
      ]
    },
